# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL
POSTGRES_DB=smartlife
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# JWT (longue chaîne aléatoire, ex: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here

# Internal service secret (backend → ai-service)
AI_INTERNAL_SECRET=your_internal_secret_here

# Dev local uniquement (docker-compose) - creds admin des outils.
# Optionnels : si non définis, valeurs par défaut faibles (admin / smartlife123).
# À surcharger si le réseau local n'est pas de confiance.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=smartlife123

# Email (pour 2FA OTP - laisser vide pour désactiver)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
OTP_ENABLED=false
BREVO_API_KEY=your_brevo_api_key_here
SECURITY_ALERT_EMAIL=your_security_alert_recipient@example.com
